-- Machine-local LSP config — copy this to lsp_local.lua and customize.
-- lsp_local.lua is gitignored and never committed.

-- Example: Uber's managed gopls + ulsp-daemon, wired through ulsp-daemon's wrapper
-- scripts (see the ulsp-daemon README for what these do and how to launch the daemon;
-- without it running, gopls falls back to a plain, non-ulsp driver, and the ulsp
-- client below simply won't attach).

-- Requires adding to ~/go-code/.envrc.local, so gopls uses the exact Go version Bazel
-- builds with instead of the monorepo's wrapper (which breaks editor integration):
--   if bazel_out=$(readlink bazel-out); then
--       go_bin=${bazel_out%%/execroot*}/external/go_sdk/bin
--       VIM_PATH="$go_bin:$PATH"
--       export VIM_PATH
--   else
--       echo "Not setting up vim — bazel-out doesn't exist yet."
--       echo "Run: bazel build @go_sdk//:go_sdk"
--   fi
--
-- vim.env.PATH = vim.env.VIM_PATH or vim.env.PATH
--
-- vim.lsp.config('gopls', {
--   cmd = { '/home/user/go-code/tools/ide/managed_gopls.sh', '-mode=stdio' },
--   cmd_env = { GO111MODULE = 'off' },
--   settings = {
--     gopls = {
--       env = {
--         GOPACKAGESDRIVER = '/home/user/go-code/tools/ide/managed_gopadrv.sh',
--         GOPACKAGESDRIVER_ULSP_MODE = '1',
--       },
--       staticcheck = true,
--       gofumpt = true,
--     },
--   },
--   root_dir = '/home/user/go-code',
-- })
-- vim.lsp.enable('gopls')
--
-- -- ulsp-daemon: format on save, BUILD file updates, Bazel auto-resolve, mock gen,
-- -- and (for the Java monorepo) go-to-definition — VS Code's Java support runs on
-- -- this same daemon via its uberLanguageServer extension, not jdtls.
-- -- Separate from gopls, which still handles Go completion/hover/diagnostics.
-- --
-- -- The daemon is started by `uexec` from within a monorepo (e.g.
-- -- go-code/tools/ide/ulsp-daemon or fievel/tools/ide/ulsp/ulsp-daemon) — check
-- -- `ps aux | grep ulsp-daemon` and `cat ~/.ulspd` to confirm it's running and
-- -- to see the live lsp-address port (defaults to 27883, but verify).
-- -- Connects over TCP via socat (needs `socat` installed).
-- --
-- -- root_markers = {'.git'} lets one client config serve whichever monorepo
-- -- (go-code, fievel, ...) the current buffer lives in, instead of hardcoding
-- -- a single root_dir.
-- --
-- -- For Java in fievel, go-to-definition only works for targets with a synced
-- -- SCIP index (fievel/.scip/). Sync one with:
-- --   DEBUG=true ./tools/scip/scip_sync.sh //your/target:name
-- -- (the plain `./tools/scip/scip_sync.sh` fast path — uexec's scip-sync binary
-- -- — silently no-ops with "Found no targets to sync" on this setup; DEBUG=true
-- -- runs the underlying bazel query/build directly and works)
-- vim.lsp.config('ulsp', {
--   cmd = { 'socat', '-', 'tcp:localhost:27883,ignoreeof' },
--   filetypes = { 'go', 'java', 'starlark', 'scala' },
--   root_markers = { '.git' },
-- })
-- vim.lsp.enable('ulsp')
--
-- -- monorepo-aware format on save (arc lint expects this, not plain gofumpt)
-- vim.api.nvim_create_autocmd('BufWritePost', {
--   pattern = '*.go',
--   command = 'silent !~/go-code/tools/ide/formatter -w % | edit',
-- })

-- Example: a plain LSP server with no machine-specific wiring
-- vim.lsp.enable('lua_ls')

-- Python — pyright, installed via Brewfile/Aptfile+install.sh. No
-- machine-specific wiring needed; nvim-lspconfig's default config is enough.
-- In the Java monorepo (fievel), run tools/ide/pyright_lsp/sync.sh once (and
-- after pulling significant changes) — it generates the import-resolution
-- index pyright needs to follow imports across Bazel-managed Python packages.
-- vim.lsp.enable('pyright')
