# Symlink manager for dotfiles
brew "stow"

# Terminal multiplexer
brew "herdr"
brew "tmux"

# Editor
brew "neovim"

# Git
brew "gh"
brew "git"

# Prompt
brew "starship"

# Zsh plugins
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Terminal
cask "wezterm"

# Fonts
cask "font-hack-nerd-font"

# File manager
brew "yazi"

# Essential CLI tools
brew "fzf"        # fuzzy finder — Ctrl+R history, Ctrl+T file picker
brew "pet"        # snippet manager — Ctrl+S to search/insert saved commands
brew "ripgrep"    # fast file content search: rg "pattern"
brew "fd"         # fast file finder: fd "*.ts"
brew "jq"         # JSON query/transform: curl ... | jq '.field'
brew "zoxide"     # smart cd
brew "socat"      # neovim: ulsp-daemon TCP bridge (work only)
brew "ffmpeg"     # yazi: video preview
brew "sevenzip"   # yazi: archive preview
brew "poppler"    # yazi: PDF preview
brew "imagemagick" # yazi: image preview
